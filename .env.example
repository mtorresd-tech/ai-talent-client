# URL base del backend de orquestación de IA Talento (conecta con SuccessFactors, Bluesite, Cosinte y Medilaboral).
VITE_API_BASE_URL=

# URL de SAP SuccessFactors a la que se redirige tras confirmar el prefiltro
# telefónico (para diligenciar allá el resultado de la llamada). Si queda vacía,
# no se abre nada al confirmar.
VITE_URL_SUCCESSFACTORS=

# Registro de aplicación en Microsoft Entra ID, para @geb/auth.
# Si CLIENT_ID o TENANT_ID quedan vacíos, la app usa un login simulado en
# memoria (ver src/shared/auth/DevAuthProvider.tsx) en vez de redirigir a
# Microsoft, para poder navegar el resto de las pantallas mientras no exista
# el app registration real.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
VITE_ENTRA_SCOPES=
